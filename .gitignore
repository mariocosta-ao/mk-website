# ========================
# MUKANDA — .gitignore
# ========================



# Sistema operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editores de código
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Node / npm (se utilizado no futuro)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
package-lock.json
yarn.lock

# Build / dist
dist/
build/
.cache/
.parcel-cache/

# Variáveis de ambiente
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
*.log
logs/

# Ficheiros temporários
*.tmp
*.temp
.sass-cache/

# Assets originais / não optimizados (opcional)
src/assets/img/raw/

# Backups
*.bak
*.backup
